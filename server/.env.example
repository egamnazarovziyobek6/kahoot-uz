# Kahoot UZ server sozlamalari
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Baza (ixtiyoriy — bo'lmasa server/data/kahoot.sqlite ishlatiladi)
DB_PATH=

# Sessiya — bularni o'zingiz o'ylab topgan uzun tasodifiy satr bilan almashtiring
JWT_SECRET=o'zgartiring-maxfiy-kalit
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Faqat lokal ishlab chiqish uchun: Google/Telegram kalitlari tayyor bo'lmaguncha
# /login sahifasida "Sinov sifatida kirish" tugmasini ochadi. Productionda true qilib qoldirmang!
ALLOW_DEV_LOGIN=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:5173/api/auth/google/callback (Vite proxy orqali)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Telegram bot — @BotFather'ga /newbot, keyin /setdomain bilan haqiqiy domen ko'rsating
# (Telegram Login Widget localhost'da ishlamaydi — deploy qilingan domenga yoki tunnelga kerak)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Moderatsiya — foydalanuvchi kamera bilan yuklagan har bir profil rasmi (18+/nomaqbul
# tarkibning oldini olish uchun) shu Telegram chatiga yuboriladi. Bo'sh qoldirilsa, bu
# funksiya jim o'chiq turadi. Chat ID olish: botingizga birorta xabar yozing, keyin
# https://api.telegram.org/bot<TOKEN>/getUpdates manzilini oching — "chat":{"id": ...} shu yerda.
TELEGRAM_MOD_CHAT_ID=

# Gemini AI — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Admin panel (/admin) — shu emaillar bilan Google orqali kirgan hisoblar admin bo'ladi
# (vergul bilan ajratib bir nechtasini yozish mumkin)
ADMIN_EMAILS=
